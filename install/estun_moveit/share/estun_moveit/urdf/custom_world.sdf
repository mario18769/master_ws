  <model name="Druckpruefmaschine">
    <pose>-1.1 0.65 0 0 0 0</pose>
    <static>true</static>
    <link name="link">
      <inertial>
        <mass>1.0</mass>
        <inertia> <!-- inertias are tricky to compute -->
          <!-- http://gazebosim.org/tutorials?tut=inertia&cat=build_robot -->
          <ixx>0.083</ixx>       <!-- for a box: ixx = 0.083 * mass * (y*y + z*z) -->
          <ixy>0.0</ixy>         <!-- for a box: ixy = 0 -->
          <ixz>0.0</ixz>         <!-- for a box: ixz = 0 -->
          <iyy>0.083</iyy>       <!-- for a box: iyy = 0.083 * mass * (x*x + z*z) -->
          <iyz>0.0</iyz>         <!-- for a box: iyz = 0 -->
          <izz>0.083</izz>       <!-- for a box: izz = 0.083 * mass * (x*x + y*y) -->
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
            <mesh><uri>file://home/mario/master_ws/install/estun_control/share/estun_control/meshes/Druckpruefmaschine.stl</uri></mesh>
          </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <mesh><uri>file://home/mario/master_ws/install/estun_control/share/estun_control/meshes/Druckpruefmaschine.stl</uri></mesh>
        </geometry>
        <material>
          <ambient>0.15 0.07 0.02 1</ambient>
          <diffuse>0.95 0.45 0.05 1</diffuse>
          <specular>0.9 0.85 0.8 1</specular>
        </material>
      </visual>
    </link>
  </model>

