<gazebo reference="finger_tip_left">
  <material>${body_color}</material>
  <mu1>1.0</mu1>
  <mu2>1.0</mu2>
  <kp>1e15</kp>
  <kd>1e13</kd>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="finger_tip_right">
